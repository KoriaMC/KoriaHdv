{
  "type": "HUD",
  "note": "Toast de l'hôtel des ventes (plugin KoriaHdv, v1), même style que le toast de territoire. Variables : %var_hdv_toast_categorie%, %var_hdv_toast_titre%, %var_hdv_toast_sous_titre%, %var_hdv_toast_message% (texte long, si %var_hdv_toast_mode_message% == true), %var_hdv_toast_icone% et %var_hdv_toast_<vente|achat|info|erreur>% (true / false). Barre de temps : %local_notif_restant% / %local_notif_duree%.",
  "width": 184,
  "height": 42,
  "anchor": "TOP_RIGHT",
  "offsetX": -8,
  "offsetY": 56,
  "scaleMode": "ADAPT",
  "referenceWidth": 480,
  "referenceHeight": 270,
  "openAnimation": "SLIDE_LEFT",
  "animationDuration": 300,
  "easing": "EASE_OUT",
  "notifyDuration": 4000,
  "fadeOut": 450,
  "playerMovable": true,
  "refreshTicks": 10,
  "elements": [
    {
      "type": "RECT",
      "id": "ombre",
      "x": 1,
      "y": 2,
      "width": 184,
      "height": 42,
      "color": "#46000000",
      "radius": 8
    },
    {
      "type": "RECT",
      "id": "fond",
      "x": 0,
      "y": 0,
      "width": 184,
      "height": 42,
      "color": "#F4141820",
      "gradient": "#F40E1117",
      "radius": 8,
      "borderColor": "#16FFFFFF",
      "borderWidth": 1
    },
    {
      "type": "RECT",
      "id": "tuile_vente",
      "x": 8,
      "y": 8,
      "width": 26,
      "height": 26,
      "color": "#264ADE80",
      "radius": 7,
      "borderColor": "#504ADE80",
      "borderWidth": 1,
      "condition": "%var_hdv_toast_vente% == true"
    },
    {
      "type": "RECT",
      "id": "tuile_erreur",
      "x": 8,
      "y": 8,
      "width": 26,
      "height": 26,
      "color": "#26F05252",
      "radius": 7,
      "borderColor": "#50F05252",
      "borderWidth": 1,
      "condition": "%var_hdv_toast_erreur% == true"
    },
    {
      "type": "RECT",
      "id": "tuile_info",
      "x": 8,
      "y": 8,
      "width": 26,
      "height": 26,
      "color": "#2694A3B8",
      "radius": 7,
      "borderColor": "#5094A3B8",
      "borderWidth": 1,
      "condition": "%var_hdv_toast_info% == true"
    },
    {
      "type": "RECT",
      "id": "tuile_achat",
      "x": 8,
      "y": 8,
      "width": 26,
      "height": 26,
      "color": "#2660A5FA",
      "radius": 7,
      "borderColor": "#5060A5FA",
      "borderWidth": 1,
      "condition": "%var_hdv_toast_achat% == true"
    },
    {
      "type": "ITEM",
      "id": "icone",
      "x": 13,
      "y": 13,
      "width": 16,
      "height": 16,
      "item": "%var_hdv_toast_icone%"
    },
    {
      "type": "TEXT",
      "id": "categorie",
      "x": 42,
      "y": 7,
      "width": 134,
      "height": 10,
      "scale": 0.58,
      "shadow": false,
      "text": "%var_hdv_toast_categorie%"
    },
    {
      "type": "TEXT",
      "id": "titre",
      "x": 42,
      "y": 16,
      "width": 134,
      "height": 10,
      "scale": 0.95,
      "shadow": false,
      "text": "%var_hdv_toast_titre%",
      "condition": "%var_hdv_toast_mode_message% != true"
    },
    {
      "type": "TEXT",
      "id": "sous_titre",
      "x": 42,
      "y": 27,
      "width": 134,
      "height": 10,
      "scale": 0.66,
      "shadow": false,
      "text": "%var_hdv_toast_sous_titre%",
      "condition": "%var_hdv_toast_mode_message% != true"
    },
    {
      "type": "TEXT",
      "id": "message",
      "x": 42,
      "y": 16,
      "width": 134,
      "height": 20,
      "scale": 0.62,
      "shadow": false,
      "wrap": true,
      "text": "%var_hdv_toast_message%",
      "condition": "%var_hdv_toast_mode_message% == true"
    },
    {
      "type": "PROGRESS",
      "id": "temps_fond",
      "x": 8,
      "y": 37,
      "width": 168,
      "height": 2,
      "shape": "BAR",
      "value": "0",
      "max": "1",
      "color": "#00000000",
      "backgroundColor": "#14FFFFFF",
      "radius": 1,
      "text": ""
    },
    {
      "type": "PROGRESS",
      "id": "temps_vente",
      "x": 8,
      "y": 37,
      "width": 168,
      "height": 2,
      "shape": "BAR",
      "value": "%local_notif_restant%",
      "max": "%local_notif_duree%",
      "color": "#FF4ADE80",
      "backgroundColor": "#00000000",
      "radius": 1,
      "text": "",
      "condition": "%var_hdv_toast_vente% == true"
    },
    {
      "type": "PROGRESS",
      "id": "temps_erreur",
      "x": 8,
      "y": 37,
      "width": 168,
      "height": 2,
      "shape": "BAR",
      "value": "%local_notif_restant%",
      "max": "%local_notif_duree%",
      "color": "#FFF05252",
      "backgroundColor": "#00000000",
      "radius": 1,
      "text": "",
      "condition": "%var_hdv_toast_erreur% == true"
    },
    {
      "type": "PROGRESS",
      "id": "temps_info",
      "x": 8,
      "y": 37,
      "width": 168,
      "height": 2,
      "shape": "BAR",
      "value": "%local_notif_restant%",
      "max": "%local_notif_duree%",
      "color": "#FF94A3B8",
      "backgroundColor": "#00000000",
      "radius": 1,
      "text": "",
      "condition": "%var_hdv_toast_info% == true"
    },
    {
      "type": "PROGRESS",
      "id": "temps_achat",
      "x": 8,
      "y": 37,
      "width": 168,
      "height": 2,
      "shape": "BAR",
      "value": "%local_notif_restant%",
      "max": "%local_notif_duree%",
      "color": "#FF60A5FA",
      "backgroundColor": "#00000000",
      "radius": 1,
      "text": "",
      "condition": "%var_hdv_toast_achat% == true"
    }
  ]
}
